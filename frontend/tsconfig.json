{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "types": ["node", "vite/client"],
    "customConditions": ["workspace", "@tanstack/custom-condition"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../packages/api-client/src/electron.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
