{
  "name": "@workspace/shared-paths",
  "version": "1.0.0",
  "description": "Shared path resolution for Project Guardian — used by both CLI and Electron app",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true})\""
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "~5.9.2"
  }
}
